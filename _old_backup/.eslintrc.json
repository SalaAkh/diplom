{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "indent": ["error", 4],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "curly": "error",
    "eqeqeq": "error"
  },
  "globals": {
    "THREE": "readonly",
    "Chart": "readonly",
    "app": "writable",
    "i18n": "readonly",
    "resourceLoader": "readonly"
  }
}
